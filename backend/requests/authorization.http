@BASE_URL=http://localhost:3000/roles
@ROLE_ID=1c2e9d5b-2c3a-4d6e-9f8a-0b1c2d3e4f50

### List roles
GET {{BASE_URL}}


### Get role
GET {{BASE_URL}}/{{ROLE_ID}}


### Create role
POST {{BASE_URL}}
Content-Type: application/json

{
  "name": "manager",
  "permissions": ["orders:read", "orders:process", "reports:view_sales"],
  "isSuperAdmin": false
}


### Rename role
PATCH {{BASE_URL}}/{{ROLE_ID}}
Content-Type: application/json

{
  "name": "senior-manager"
}


### Grant permission
POST {{BASE_URL}}/{{ROLE_ID}}/permissions
Content-Type: application/json

{
  "permission": "orders:manage"
}


### Revoke permission
DELETE {{BASE_URL}}/{{ROLE_ID}}/permissions/orders:manage


### Set super admin
PATCH {{BASE_URL}}/{{ROLE_ID}}/super-admin
Content-Type: application/json

{
  "isSuperAdmin": true
}
