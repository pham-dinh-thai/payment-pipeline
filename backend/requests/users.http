@BASE_URL=http://localhost:3000/users
@USER_ID=69847b83-f448-40d4-9942-3d3dfa0d6acb
@ROLE_ID=1c2e9d5b-2c3a-4d6e-9f8a-0b1c2d3e4f50

### Create
POST {{BASE_URL}}
Content-Type: application/json

{
  "firstName": "Thai",
  "lastName": "Thai",
  "email": "test@example.com"
}


### Change email
PATCH {{BASE_URL}}/{{USER_ID}}/email
Content-Type: application/json

{
  "email": "test123456@example.com"
}


### Assign role
POST {{BASE_URL}}/{{USER_ID}}/roles
Content-Type: application/json

{
  "roleId": "{{ROLE_ID}}"
}


### Remove role
DELETE {{BASE_URL}}/{{USER_ID}}/roles/{{ROLE_ID}}
