@BASE_URL=http://localhost:3000/api
@ROLE_ID=replace-with-role-id

### Login (run this first to obtain an access token)
# @name login
POST {{BASE_URL}}/authentication/login
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "your-password"
}

### Access token from the login response above
@ACCESS_TOKEN={{login.response.body.$.accessToken}}

### List roles
GET {{BASE_URL}}/roles
Authorization: Bearer {{ACCESS_TOKEN}}


### Get role
GET {{BASE_URL}}/roles/{{ROLE_ID}}
Authorization: Bearer {{ACCESS_TOKEN}}


### Create role
POST {{BASE_URL}}/roles
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "name": "staff",
  "permissions": ["orders:read", "orders:process", "reports:view_sales"],
  "isSuperAdmin": false
}


### Rename role
PATCH {{BASE_URL}}/roles/{{ROLE_ID}}
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "name": "senior-manager"
}


### Grant permission
POST {{BASE_URL}}/roles/{{ROLE_ID}}/permissions
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "permission": "orders:manage"
}


### Revoke permission
DELETE {{BASE_URL}}/roles/{{ROLE_ID}}/permissions/orders:manage
Authorization: Bearer {{ACCESS_TOKEN}}


### Set super admin
PATCH {{BASE_URL}}/roles/{{ROLE_ID}}/super-admin
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "isSuperAdmin": true
}
