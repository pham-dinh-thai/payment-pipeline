@BASE_URL=http://localhost:3000/api/users
@USER_ID=replace-with-user-id
@ROLE_ID=replace-with-role-id

### Create
POST {{BASE_URL}}
Content-Type: application/json

{
  "firstName": "Thai",
  "lastName": "Thai",
  "email": "test@example.com"
}


### Change email
PATCH {{BASE_URL}}/{{USER_ID}}/email
Content-Type: application/json

{
  "email": "test123456@example.com"
}


### Assign role
POST {{BASE_URL}}/{{USER_ID}}/roles
Content-Type: application/json

{
  "roleId": "{{ROLE_ID}}"
}


### Remove role
DELETE {{BASE_URL}}/{{USER_ID}}/roles/{{ROLE_ID}}
